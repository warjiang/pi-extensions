{
  "name": "@ai.hermes/volcengine-coding-plan",
  "version": "0.1.2",
  "description": "Pi extension for Volcengine Coding Plan",
  "type": "module",
  "keywords": [
    "pi-package",
    "volcengine",
    "coding-plan"
  ],
  "files": [
    "extensions"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/warjiang/pi-extensions.git",
    "directory": "packages/volcengine-coding-plan"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "scripts": {
    "dev": "node -e \"console.log('Coding Plan debug log: ' + require('node:path').join(require('node:os').tmpdir(), 'volcengine-coding-plan-debug.log'))\" && VOLCENGINE_CODINGPLAN_DEBUG=1 pi -e .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  }
}

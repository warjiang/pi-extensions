{
  "name": "@ai.hermes/lark",
  "version": "0.1.0",
  "description": "Secure Pi integration for the official Lark CLI",
  "type": "module",
  "keywords": [
    "pi-package",
    "lark",
    "feishu",
    "lark-cli"
  ],
  "files": [
    "extensions",
    "skills",
    "scripts",
    "snapshots"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/warjiang/pi-extensions.git",
    "directory": "packages/lark"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "dev": "pi -e .",
    "dev:bridge": "node --experimental-strip-types extensions/bridge-daemon.ts --daemon --foreground",
    "generate:skills": "node scripts/generate-skills.mjs --write",
    "update:snapshots": "node scripts/generate-skills.mjs --update-snapshot --write",
    "check:sync": "node scripts/generate-skills.mjs --check && node --experimental-strip-types scripts/check-bridge-snapshot.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "0.84.2",
    "@larksuite/cli": "1.0.87",
    "@larksuiteoapi/node-sdk": "1.73.0",
    "qrcode": "1.5.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.6"
  }
}

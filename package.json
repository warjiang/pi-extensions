{
  "name": "pi-extensions",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "release:verify-bump": "node scripts/release.mjs verify-bump",
    "release:dry-run": "node scripts/release.mjs publish --package all --tag latest --dry-run",
    "dev:ark": "pnpm --filter @ai.hermes/volcengine-ark dev",
    "dev:lark": "pnpm --filter @ai.hermes/lark dev",
    "dev:lark-channel": "pnpm --filter @ai.hermes/lark-channel dev",
    "dev:coding-plan": "pnpm --filter @ai.hermes/volcengine-coding-plan dev",
    "dev:agent-plan": "pnpm --filter @ai.hermes/volcengine-agent-plan dev"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@types/node": "^24.12.4",
    "typescript": "^5.9.3"
  }
}
